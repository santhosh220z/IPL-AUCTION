{
  "name": "ipl-auction",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "node server/index.js",
    "lan": "npm run build && npm run start",
    "data:build": "node scripts/build-data.mjs",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
